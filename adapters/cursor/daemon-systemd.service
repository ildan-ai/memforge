# Linux systemd user-service for memforge memory-watch.
#
# Setup:
#   1. Install the package (`pip install ildan-memforge`). It installs the
#      `memory-watch` command, `watchdog` included. Find its absolute path
#      with `command -v memory-watch` in the environment you installed into.
#   2. Edit ExecStart: put that path first, and name your memory folder after
#      --path. systemd needs absolute paths and does not expand `~`.
#   3. Copy to ~/.config/systemd/user/memforge-watch.service.
#   4. Enable + start:
#        systemctl --user daemon-reload
#        systemctl --user enable --now memforge-watch.service
#      Status:
#        systemctl --user status memforge-watch.service
#      Stop:
#        systemctl --user stop memforge-watch.service
#
# inotify-tools is not needed: memory-watch uses the watchdog library, which
# comes with the package.

[Unit]
Description=MemForge memory-folder filesystem watcher (auto-commit on write)
After=default.target

[Service]
Type=simple
ExecStart=<absolute path to memory-watch> --path <absolute path to your memory folder> --quiet
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
